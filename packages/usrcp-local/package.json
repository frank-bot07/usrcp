{
  "name": "usrcp-local",
  "version": "0.2.6",
  "description": "Local MCP server for USRCP — persistent AI memory on your machine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-local": "dist/index.js",
    "usrcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "cd ../usrcp-core && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js serve",
    "lint": "tsc --noEmit",
    "pretest": "(cd ../usrcp-discord && npm run build) && (cd ../usrcp-telegram && npm run build)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "mcp",
    "ai-memory",
    "context-protocol",
    "llm",
    "agent"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "usrcp-core": "file:../usrcp-core",
    "@anthropic-ai/sdk": "^0.115.0",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "yaml": "^2.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-local"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-local#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
