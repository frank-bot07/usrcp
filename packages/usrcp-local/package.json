{
  "name": "usrcp-local",
  "version": "0.1.8",
  "description": "Local MCP server for USRCP — persistent AI memory on your machine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./encryption": "./dist/encryption.js",
    "./ledger": "./dist/ledger/index.js",
    "./crypto": "./dist/crypto.js",
    "./pair": "./dist/pair.js",
    "./rotate-identity": "./dist/rotate-identity.js",
    "./scope-enforcement": "./dist/scope-enforcement.js",
    "./google-oauth": "./dist/adapters/google-oauth/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-local": "dist/index.js",
    "usrcp": "dist/index.js"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require(\\\"fs\\\"); for (const p of [\\\"node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-local/node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-stream/node_modules/better-sqlite3/build\\\"]) fs.rmSync(p,{recursive:true,force:true})\" && npm rebuild better-sqlite3",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js serve",
    "lint": "tsc --noEmit",
    "pretest": "(cd ../usrcp-discord && npm run build) && (cd ../usrcp-telegram && npm run build)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "mcp",
    "ai-memory",
    "context-protocol",
    "llm",
    "agent"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "yaml": "^2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.17",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-local"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-local#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
