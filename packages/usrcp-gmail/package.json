{
  "name": "usrcp-gmail",
  "version": "0.0.1",
  "description": "Gmail capture adapter for USRCP - polls the configured user's SENT messages and appends them to the local ledger",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-gmail": "dist/index.js"
  },
  "scripts": {
    "prebuild": "cd ../usrcp-local && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-local && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "gmail",
    "adapter",
    "memory",
    "email"
  ],
  "author": "USRCP Contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@googleapis/gmail": "^16.0.0",
    "google-auth-library": "^10.1.0",
    "usrcp-local": "file:../usrcp-local"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "22.19.17",
    "better-sqlite3": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
