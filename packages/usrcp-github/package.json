{
  "name": "usrcp-github",
  "version": "0.2.5",
  "description": "GitHub capture adapter for USRCP - polls the REST API for pull requests authored by the configured user and appends them to the local ledger",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-github": "dist/index.js"
  },
  "scripts": {
    "prebuild": "cd ../usrcp-adapter-kit && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-adapter-kit && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "github",
    "adapter",
    "memory",
    "pull-requests"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2",
    "usrcp-core": "file:../usrcp-core",
    "usrcp-adapter-kit": "file:../usrcp-adapter-kit"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-github"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-github#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
