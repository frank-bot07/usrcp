{
  "name": "usrcp-github",
  "version": "0.1.0",
  "description": "GitHub capture adapter for USRCP - polls the REST API for pull requests authored by the configured user and appends them to the local ledger",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-github": "dist/index.js"
  },
  "scripts": {
    "postinstall": "npm rebuild better-sqlite3",
    "prebuild": "cd ../usrcp-local && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-local && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "github",
    "adapter",
    "memory",
    "pull-requests"
  ],
  "author": "USRCP Contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.2",
    "usrcp-local": "file:../usrcp-local"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "22.19.17",
    "better-sqlite3": "*",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
