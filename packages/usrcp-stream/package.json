{
  "name": "usrcp-stream",
  "version": "0.2.1",
  "description": "Cross-surface conversation layer for USRCP - encrypted local capture, embeddings, thread stitching, active-surface presence",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-stream": "dist/index.js"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require(\\\"fs\\\"); for (const p of [\\\"node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-core/node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-stream/node_modules/better-sqlite3/build\\\"]) fs.rmSync(p,{recursive:true,force:true})\" && npm rebuild better-sqlite3",
    "prebuild": "cd ../usrcp-core && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js serve",
    "lint": "tsc --noEmit",
    "pretest": "(cd ../usrcp-core && npm run build) && (cd ../usrcp-cloud && npm run build)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "mcp",
    "ai-memory",
    "conversation",
    "embeddings",
    "vector-search"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "sqlite-vec": "^0.1.6",
    "usrcp-core": "file:../usrcp-core",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.17",
    "pg-mem": "^3.0.5",
    "typescript": "5.9.3",
    "usrcp-cloud": "file:../usrcp-cloud",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-stream"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-stream#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
