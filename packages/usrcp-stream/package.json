{
  "name": "usrcp-stream",
  "version": "0.0.1",
  "description": "Cross-surface conversation layer for USRCP — encrypted local capture, embeddings, thread stitching, active-surface presence",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-stream": "dist/index.js"
  },
  "scripts": {
    "prebuild": "cd ../usrcp-local && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js serve",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-local && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "mcp",
    "ai-memory",
    "conversation",
    "embeddings",
    "vector-search"
  ],
  "author": "USRCP Contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^8.4.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "11.10.0",
    "sqlite-vec": "^0.1.6",
    "usrcp-local": "file:../usrcp-local",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  }
}
