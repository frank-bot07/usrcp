{
  "name": "usrcp-google-calendar",
  "version": "0.1.8",
  "description": "Google Calendar capture adapter for USRCP - polls the configured user's primary calendar for past events they attended and appends them to the local ledger",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-google-calendar": "dist/index.js"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require(\\\"fs\\\"); for (const p of [\\\"node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-local/node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-stream/node_modules/better-sqlite3/build\\\"]) fs.rmSync(p,{recursive:true,force:true})\" && npm rebuild better-sqlite3",
    "prebuild": "cd ../usrcp-adapter-kit && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-adapter-kit && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "google-calendar",
    "adapter",
    "memory",
    "calendar"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@googleapis/calendar": "^9.0.0",
    "google-auth-library": "^9.15.0",
    "usrcp-local": "file:../usrcp-local",
    "usrcp-adapter-kit": "file:../usrcp-adapter-kit"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "22.19.17",
    "better-sqlite3": "12.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-google-calendar"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-google-calendar#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
