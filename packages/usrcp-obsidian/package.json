{
  "name": "usrcp-obsidian",
  "version": "0.2.5",
  "description": "Obsidian capture adapter for USRCP — watches a local vault and appends note edits to the ledger",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-obsidian": "dist/index.js"
  },
  "scripts": {
    "prebuild": "cd ../usrcp-core && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-core && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "obsidian",
    "adapter",
    "memory",
    "notes"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "usrcp-core": "file:../usrcp-core"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-obsidian"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-obsidian#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
