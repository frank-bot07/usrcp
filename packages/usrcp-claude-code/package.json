{
  "name": "usrcp-claude-code",
  "version": "0.2.8",
  "description": "USRCP capture adapter for Claude Code CLI - tails ~/.claude/projects/<dir>/*.jsonl session transcripts into usrcp-stream",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-claude-code": "dist/index.js"
  },
  "scripts": {
    "prebuild": "(cd ../usrcp-core && npm run build) && (cd ../usrcp-stream && npm run build)",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "(cd ../usrcp-core && npm run build) && (cd ../usrcp-stream && npm run build)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "claude-code",
    "adapter",
    "memory",
    "stream"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "usrcp-core": "file:../usrcp-core",
    "usrcp-stream": "file:../usrcp-stream"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "26.1.1",
    "better-sqlite3": "12.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-claude-code"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-claude-code#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
