{
  "name": "usrcp-extension",
  "version": "0.2.0",
  "description": "Chrome browser extension for capturing claude.ai conversations into the USRCP ledger",
  "type": "module",
  "main": "dist/setup.js",
  "exports": {
    ".": "./dist/setup.js",
    "./setup": "./dist/setup.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/manifest.json",
    "native-host/usrcp-bridge.cjs",
    "native-host/manifest-template.json"
  ],
  "scripts": {
    "postinstall": "node -e \"const fs=require(\\\"fs\\\"); for (const p of [\\\"node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-local/node_modules/better-sqlite3/build\\\",\\\"node_modules/usrcp-stream/node_modules/better-sqlite3/build\\\"]) fs.rmSync(p,{recursive:true,force:true})\" && npm rebuild better-sqlite3",
    "build": "node build.mjs",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-local && npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "usrcp",
    "chrome",
    "extension",
    "adapter",
    "memory"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "usrcp-core": "file:../usrcp-core",
    "usrcp-local": "file:../usrcp-local"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.40",
    "@types/node": "22.19.17",
    "better-sqlite3": "12.10.0",
    "esbuild": "^0.24.0",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-extension"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-extension#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
