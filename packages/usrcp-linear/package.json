{
  "name": "usrcp-linear",
  "version": "0.2.6",
  "description": "Linear capture adapter for USRCP — polls Linear's GraphQL API for issues and comments authored by the configured user, and appends them to the local ledger",
  "main": "dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-linear": "dist/index.js"
  },
  "scripts": {
    "prebuild": "cd ../usrcp-adapter-kit && npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "cd ../usrcp-adapter-kit && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "linear",
    "adapter",
    "memory",
    "issue-tracker"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@linear/sdk": "^88.2.0",
    "usrcp-core": "file:../usrcp-core",
    "usrcp-adapter-kit": "file:../usrcp-adapter-kit"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-linear"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-linear#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
