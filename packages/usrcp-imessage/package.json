{
  "name": "usrcp-imessage",
  "version": "0.2.7",
  "description": "iMessage capture+reader adapter for USRCP — macOS-only, shells out to steipete/imsg for chat.db access",
  "main": "dist/index.js",
  "os": [
    "darwin"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "bin": {
    "usrcp-imessage": "dist/index.js"
  },
  "scripts": {
    "prebuild": "(cd ../usrcp-adapter-kit && npm run build) && (cd ../usrcp-stream && npm run build)",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "pretest": "(cd ../usrcp-adapter-kit && npm run build) && (cd ../usrcp-stream && npm run build)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "usrcp",
    "imessage",
    "adapter",
    "memory",
    "macos"
  ],
  "author": "Chad Garner",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "usrcp-adapter-kit": "file:../usrcp-adapter-kit",
    "usrcp-core": "file:../usrcp-core",
    "usrcp-stream": "file:../usrcp-stream"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "26.1.1",
    "better-sqlite3": "12.10.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frank-bot07/usrcp.git",
    "directory": "packages/usrcp-imessage"
  },
  "homepage": "https://github.com/frank-bot07/usrcp/tree/main/packages/usrcp-imessage#readme",
  "bugs": "https://github.com/frank-bot07/usrcp/issues"
}
